<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoomMate - run tasks" Width="700" Height="740" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: the open model goes in the subtitle -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <StackPanel>
                <TextBlock Text="Tasks" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="tx_model" FontSize="12" Foreground="White" Opacity="0.9" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- project and filters -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="10,6,10,4">
            <StackPanel>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Project" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_project" SelectionChanged="on_project"/></Grid>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Room or name" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="tb_filter" TextChanged="on_filter"/></Grid>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Kind" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_kind" SelectionChanged="on_filter"/></Grid>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Level" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_level" SelectionChanged="on_filter"/></Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="bt_tick" Content="Tick shown" Width="110" Click="on_tick_shown"/>
                    <Button x:Name="bt_untick" Content="Untick shown" Width="110" Margin="8,0,0,0" Click="on_untick_shown"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- the tasks: a check box each, in a plain stack (no grid or list view) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,10,0">
            <StackPanel x:Name="sp_tasks" Margin="4,4,4,4"/>
        </ScrollViewer>

        <!-- status and buttons -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="10" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="tx_status" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="440"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" Click="on_cancel"/>
                <Button DockPanel.Dock="Right" x:Name="bt_run" Content="Run" Width="90" IsDefault="True" Click="on_run"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoomMate - blueprint export" Width="900" Height="760" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: the model the rooms and sheets are read from goes in the subtitle -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <StackPanel>
                <TextBlock Text="Blueprint Export" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="tx_model" FontSize="12" Foreground="White" Opacity="0.9" TextWrapping="Wrap"/>
                <TextBlock x:Name="tx_server" FontSize="11" Foreground="White" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- where the blueprints go and which phase the rooms are read in -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="10,10,10,4">
            <StackPanel>
                <TextBlock Text="Push to" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Project" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_project" SelectionChanged="on_project"/></Grid>
                <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Phase" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_phase" SelectionChanged="on_phase"/></Grid>
                <TextBlock x:Name="tx_phase_note" Text="The rooms listed are the placed rooms of the phase." Opacity="0.6" Margin="110,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- one row per room is made in code: a check box with the room, the blueprint's name, and a button that opens a list of sheets -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="10,4,10,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" x:Name="tx_found" Text="Rooms" FontWeight="SemiBold" VerticalAlignment="Center" Width="110"/>
                    <Button DockPanel.Dock="Right" Content="Check none" Padding="8,1" Margin="6,0,0,0" Click="on_check_none"/>
                    <Button DockPanel.Dock="Right" Content="Check all matched" Padding="8,1" Margin="6,0,0,0" Click="on_check_matched" ToolTip="Checks the listed rooms that have sheets"/>
                    <TextBox x:Name="tb_find" TextChanged="on_find" ToolTip="Words must all appear in the room label; -word leaves out rooms containing it"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,2">
                    <DockPanel LastChildFill="True" Margin="0,0,0,2">
                        <TextBlock DockPanel.Dock="Left" Text="Match" FontWeight="SemiBold" VerticalAlignment="Center" Width="110"/>
                        <Button DockPanel.Dock="Right" Content="Apply to listed rooms" Padding="8,1" Margin="6,0,0,0" Click="on_apply_rule"/>
                        <TextBlock DockPanel.Dock="Left" Text="Sheet" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox DockPanel.Dock="Left" x:Name="tb_rule_sheet" Width="150" TextChanged="on_rule_change" ToolTip="Text with {Parameter} placeholders, filled from each SHEET's parameters, e.g. {Sheet Number}"/>
                        <ComboBox DockPanel.Dock="Left" x:Name="cb_rule_relation" Width="90" Margin="4,0,4,0" SelectionChanged="on_rule_change"/>
                        <TextBlock DockPanel.Dock="Left" Text="room" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="tb_rule_room" ToolTip="Text with {Parameter} placeholders, filled from each ROOM's parameters, e.g. {Number} or {Name}"/>
                    </DockPanel>
                    <TextBlock x:Name="tx_rule" Margin="110,2,0,0" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,6,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Room" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Blueprint name" FontWeight="SemiBold" Margin="6,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="Room layout sheets" FontWeight="SemiBold" Margin="6,0,0,0"/>
                </Grid>
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="sp_rooms"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- status and buttons -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="10" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="tx_status" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="560"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" Click="on_cancel"/>
                <Button DockPanel.Dock="Right" x:Name="bt_export" Content="Export" Width="90" IsDefault="True" Click="on_export"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

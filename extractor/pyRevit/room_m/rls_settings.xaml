<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoomMate - RLS settings" Width="680" Height="760" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: the model the settings belong to goes in the subtitle -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <StackPanel>
                <TextBlock Text="RLS Settings" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="tx_model" FontSize="12" Foreground="White" Opacity="0.9" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,6,10,0">
            <StackPanel>
                <!-- title blocks by sheet size -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,4">
                        <StackPanel>
                    <TextBlock Text="Title blocks by sheet size" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="A0" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_a0" SelectionChanged="on_change"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="A1" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_a1" SelectionChanged="on_change"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="A2" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_a2" SelectionChanged="on_change"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="A3" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_a3" SelectionChanged="on_change"/></Grid>
                    </StackPanel>
                </Border>
                <!-- views -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,4">
                        <StackPanel>
                    <TextBlock Text="Views" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Plan view type" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_plan_view_type" SelectionChanged="on_change"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Elevation view type" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_elevation_view_type" SelectionChanged="on_change"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Schedule base" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_schedule_base" SelectionChanged="on_change"/></Grid>
                    <TextBlock Text="Any schedule whose first filter is on the room number." Opacity="0.6" Margin="170,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- detail numbers -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,4">
                        <StackPanel>
                    <TextBlock Text="Detail numbers on the sheet" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Elevations" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_elevation_numbering" SelectionChanged="on_change"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Floor plan" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_plan_numbering" SelectionChanged="on_change"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="3D views" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_three_d_numbering" SelectionChanged="on_change"/></Grid>
                    <TextBlock Text="Kinds set the same share one run: elevations first, then the plan, then 3D." Opacity="0.6" Margin="170,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- tags -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,4">
                        <StackPanel>
                    <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Room tag" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_room_tag" SelectionChanged="on_change"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Independent tag" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="cb_independent_tag" SelectionChanged="on_change"/></Grid>
                    <TextBlock Text="A multi-category tag. Either left empty: continue with a warning." Opacity="0.6" Margin="170,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- naming -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="0,4,0,4">
                        <StackPanel>
                    <TextBlock Text="Naming" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Sheet number" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="tb_sheet_number" TextChanged="on_change"/>
                        <ComboBox Grid.Column="2" x:Name="tk_sheet_number" SelectionChanged="on_token_sheet_number" Margin="6,0,0,0"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Sheet name" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="tb_sheet_name" TextChanged="on_change"/>
                        <ComboBox Grid.Column="2" x:Name="tk_sheet_name" SelectionChanged="on_token_sheet_name" Margin="6,0,0,0"/></Grid>
                    <Grid Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                        <TextBlock Text="View name" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="tb_view_name" TextChanged="on_change"/>
                        <ComboBox Grid.Column="2" x:Name="tk_view_name" SelectionChanged="on_token_view_name" Margin="6,0,0,0"/></Grid>
                    <TextBlock Text="Fixed text and {Room Parameter} in braces, for example RLS-{Number}." Opacity="0.6" Margin="170,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- status and buttons -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="10" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="tx_status" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="420"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" Click="on_cancel"/>
                <Button DockPanel.Dock="Right" Content="Save" Width="90" IsDefault="True" Click="on_save"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

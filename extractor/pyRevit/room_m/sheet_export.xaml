<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoomMate - export sheets to the library" Width="820" Height="720" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="tx_model" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Project" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="cb_project" SelectionChanged="on_change"/>
        </Grid>

        <!-- one row per sheet is made in code: a check box with the sheet, and a button that opens a list of rooms -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Sheet" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Rooms the sheet covers (optional)" FontWeight="SemiBold"/>
                </Grid>
                <StackPanel x:Name="sp_sheets"/>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" x:Name="tx_status" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="460"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" Click="on_cancel"/>
            <Button DockPanel.Dock="Right" x:Name="bt_export" Content="Export" Width="90" IsDefault="True" Click="on_export"/>
        </DockPanel>
    </Grid>
</Window>

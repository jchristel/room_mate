<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoomMate - export sheets to the library" Width="820" Height="740" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header: the model the sheets are read from goes in the subtitle -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,10">
            <StackPanel>
                <TextBlock Text="Sheets Exports" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="tx_model" FontSize="12" Foreground="White" Opacity="0.9" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- where the sheets go -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="10,10,10,4">
            <StackPanel>
                <TextBlock Text="Project" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Push to" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="cb_project" SelectionChanged="on_change"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- one row per sheet is made in code: a check box with the sheet, and a button that opens a list of rooms -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="2" Padding="10" Margin="10,4,10,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Sheets" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Rooms the sheet covers (optional)" FontWeight="SemiBold"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="sp_sheets"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- status and buttons -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="10" Margin="0,6,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="tx_status" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="460"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True" Click="on_cancel"/>
                <Button DockPanel.Dock="Right" x:Name="bt_export" Content="Export" Width="90" IsDefault="True" Click="on_export"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
